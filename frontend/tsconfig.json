{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "assets/*": ["assets/*"],
      "pages/*": ["pages/*"],
      "components/*": ["components/*"],
      "utils/*": ["utils/*"],
      "services/*": ["services/*"],
      "models/*": ["models/*"],
      "common/*": ["common/*"],
      "store/*": ["store/*"],
      "types/*": ["types/*"]
    }
  },
  "include": ["src"]
}